{% extends "base.html.twig" %}
{% block title %}
	Bulkregistrering
{% endblock %}

{% block body %}
	<main class="bulk-reg" data-controller="components--bulkreg">
		<h1 class="mb-3">
			Bulkregga
		</h1>
		<button data-action="components--bulkreg#save">Spara</button>
		<hr class="my-2">
		<div class="flex row gap-2 wrap" data-controller="bulkreg">
			<div class="w-40">
				<div class="mb-1"><label for="location">
						Plats
					</label>
					<select name="location" id="location" data-components--bulkreg-target="locations">
						{% for loc in locations %}
							<option value="{{ loc.id }}">{{ loc.name }}</option>
						{% endfor %}
					</select></div>
				<label for="datetime">
					Tidpunkt
				</label>
				<input data-components--bulkreg-target="datetime" name="datetime" type="datetime-local" id="datetime">
			</div>
			<div class="w-40 w-m-100">
				<label for="comment">Kommentar</label>
				<textarea data-components--bulkreg-target="comment" name="comment" id="comment"></textarea>
			</div>
		</div>

		<div class="flex wrap row gap-2 my-4">
			<div class="w-40 w-m-100">
				<label for="species">Arter</label>
				<input type="search" id="species" name="species"
					   data-components--bulkreg-target="searchspecies"
					   data-action="keyup->components--bulkreg#handleSearchKeypress"
				>
				<ul class="autocomplete-results" data-components--bulkreg-target="results">

				</ul>
			</div>
			<div class="w-40 w-m-100">
				<label>Valda arter</label>
				<ul class="chosen-species" data-components--bulkreg-target="selected">

				</ul>
			</div>
		</div>
	</main>
{% endblock %}

