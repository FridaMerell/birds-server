{{ form_start(form) }}
<div class="flex row wrap gap-2">

	<div class="my-1 w-40 w-m-100">
		{{ form_row(form.Location) }}
	</div>
	<div class="my-1 w-40 w-m-100">
		{{ form_row(form.DateTime) }}
	</div>
	<div class="my-1 w-40 w-m-100">
		{{ form_row(form.Comment) }}
	</div>
	<div class="my-1 w-40 w-m-100">
		{{ form_row(form.Species) }}
	</div>
	<div class="w-100 flex gap-2">

		<button class="button my-2">{{ button_label|default('Spara') }}</button>
	</div>
</div>
{{ form_end(form) }}
