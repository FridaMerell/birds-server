<form method="post" action="{{ path('app_sighting_delete', {'id': sighting.id}) }}"
	  onsubmit="return confirm('Are you sure you want to delete this item?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sighting.id) }}">
	<button class="flex row gap-1 center-vertical">
		<img src="{{ asset('assets/trash.svg') }}">
		<span>Radera</span>
	</button>
</form>
